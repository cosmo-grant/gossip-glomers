#!/usr/bin/env bash

# Stock maelstrom jar plus the extra workloads in maelstrom-ext/
ROOT_DIR=$( cd -- "$( dirname "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )

exec java -Djava.awt.headless=true -cp "${ROOT_DIR}/maelstrom/lib/maelstrom.jar:${ROOT_DIR}/maelstrom-ext" clojure.main -m maelstrom-ext.core "$@"
